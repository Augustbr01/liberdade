// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TipoCanal {
  TEXTO
  VOZ
}

enum Permissao {
  MEMBRO
  ADMIN
}

model Usuario {
  id String @id @db.Uuid @default(uuid(7))
  discordId String @unique @db.VarChar(255)
  nome String @unique @db.VarChar(50)
  avatarUrl String
  email String?
  entrou_em DateTime @default(now())

  servidores Servidor[]
  membrosDe UsuarioServidor[]
  mensagens Mensagem[]
  convites Convite[]
  banimentos BanimentoServidor[]
  @@map("usuarios")
}

model Servidor {
  id String @id @default(uuid(7)) @db.Uuid
  nome String @db.VarChar(100)
  iconeUrl String?
  donoId String @db.Uuid
  criadoEm DateTime @default(now())

  dono Usuario @relation(fields: [donoId],references: [id])
  canais Canal[]
  convites Convite[]
  membros UsuarioServidor[]
  banimentos BanimentoServidor[]
  @@map("servidores")
}

model UsuarioServidor {
  id String @id @db.Uuid @default(uuid(7))
  usuarioId String @db.Uuid
  servidorId String @db.Uuid
  permissao Permissao @default(MEMBRO)
  entrouEm DateTime @default(now())

  @@unique([usuarioId,servidorId])
  @@index([servidorId])

  usuario Usuario @relation(fields: [usuarioId],references: [id],onDelete: Cascade)
  servidor Servidor @relation(fields: [servidorId],references: [id],onDelete: Cascade)

  @@map("usuario_servidor")
}

model Canal {
  id String @id @db.Uuid @default(uuid(7))
  servidorId String @db.Uuid
  nome String @db.VarChar(50)
  tipo TipoCanal
  criadoEm DateTime @default(now())

  servidor Servidor @relation(fields: [servidorId],references: [id], onDelete: Cascade)
  mensagens Mensagem[]
  @@index([servidorId])
  @@map("canais")
}

model Convite {
  id String @id @db.Uuid @default(uuid(7))
  servidorId String @db.Uuid
  criadoPorId String @db.Uuid
  expiraEm DateTime?
  criadoEm DateTime @default(now()) 

  servidor Servidor @relation(fields: [servidorId],references: [id],onDelete: Cascade)
  criador Usuario @relation(fields: [criadoPorId],references: [id],onDelete: Cascade)
  @@map("convites")
}

model BanimentoServidor {
  id String @id @db.Uuid @default(uuid(7))
  usuarioId String @db.Uuid
  servidorId String @db.Uuid
  criadoEm DateTime

  @@unique([usuarioId,servidorId])
  @@index([servidorId])
  @@map("banimento_servidor")

  usuario Usuario @relation(fields: [usuarioId],references: [id],onDelete: Cascade)
  servidor Servidor @relation(fields: [servidorId],references: [id],onDelete: Cascade)
}

model Mensagem {
  id String @id @db.Uuid @default(uuid(7))
  canalId String @db.Uuid
  autorId String @db.Uuid
  conteudo String @db.VarChar(1000)
  editadaEm DateTime?
  criadoEm DateTime @default(now())

  @@index([canalId,criadoEm])
  canal Canal @relation(fields: [canalId],references: [id],onDelete: Cascade)
  autor Usuario @relation(fields: [autorId],references: [id],onDelete: Cascade)
  @@map("mensagens")
}

